# ==============================================================================
#           TẬP TIN MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (REACT 19 / VITE)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục frontend
#   PowerShell: Copy-Item frontend\.env-example frontend\.env
#   Bash/Linux: cp frontend/.env-example frontend/.env
# ==============================================================================

# URL gọi API xuống Spring Boot Backend
VITE_API_BASE_URL=http://localhost:8080/api

# Cấu hình Keycloak IAM OIDC Client
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=hotel-realm
VITE_KEYCLOAK_CLIENT_ID=hotel-frontend