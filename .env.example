# ==============================================================================
#      HỆ THỐNG QUẢN LÝ KHÁCH SẠN - TỆP MẪU CẤU HÌNH LOCAL DEV (.env.example)
#      (Hướng dẫn: Copy tệp này thành .env và điền các giá trị mật khẩu thật)
# ==============================================================================

# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Chạy ngoài Host: Port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hotel_booking_db
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD_HERE

# 2. LIQUIBASE MIGRATION
SPRING_LIQUIBASE_ENABLED=true
LIQUIBASE_CONTEXTS=master-data,dev-seed

# 3. REDIS CACHE (Chạy ngoài Host: Port 6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. KEYCLOAK IAM (Chạy ngoài Host: Port 8081)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_KEYCLOAK_ADMIN_PASSWORD_HERE
KEYCLOAK_REALM=hotel-realm
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/hotel-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/hotel-realm/protocol/openid-connect/certs

# Keycloak Clients
KEYCLOAK_CLIENT_ID=hotel-backend
KEYCLOAK_CLIENT_SECRET=YOUR_KEYCLOAK_CLIENT_SECRET_HERE
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# 5. CỔNG DỊCH VỤ
BACKEND_PORT=8080
FRONTEND_PORT=3000

# 6. FRONTEND REACT VITE
VITE_API_BASE_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=hotel-realm
VITE_KEYCLOAK_CLIENT_ID=hotel-frontend
