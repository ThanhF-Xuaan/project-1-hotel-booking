# ==============================================================================
# HỆ THỐNG SMARTSTAY - CẤU HÌNH HTTP BOOTSTRAP (GIAI ĐOẠN 1A)
# ==============================================================================
# Cấu hình này chỉ listen cổng 80, không yêu cầu SSL certificate.
# Mục đích: Phục vụ HTTP-01 ACME Challenge của Certbot để cấp phát chứng chỉ
# ban đầu cho smartstay.space và www.smartstay.space mà không làm Nginx bị crash loop.
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name smartstay.space www.smartstay.space;

    # Healthcheck endpoint cho Docker
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # ACME Challenge phục vụ Let's Encrypt Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Thông báo tạm thời trong khi chờ cấp phát chứng chỉ SSL
    location / {
        default_type text/html;
        return 200 '<!DOCTYPE html><html><head><meta charset="utf-8"><title>SmartStay System</title></head><body style="font-family:sans-serif;text-align:center;padding:50px;"><h2>SmartStay System - Initializing SSL Certificate...</h2><p>Hệ thống đang khởi tạo chứng chỉ bảo mật HTTPS. Vui lòng quay lại sau ít phút.</p></body></html>';
    }
}

