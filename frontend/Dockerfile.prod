# ==============================================================================
# STAGE 1: BUILD REACT VITE SPA (Node.js 20 Alpine)
# ==============================================================================
FROM node:22-alpine AS builder
WORKDIR /app

# Khai báo Build Arguments cho biến môi trường Vite (Bake vào Bundle lúc build)
ARG VITE_API_BASE_URL=""
ARG VITE_KEYCLOAK_URL=https://hotel.utc.edu.vn
ARG VITE_KEYCLOAK_REALM=hotel-realm
ARG VITE_KEYCLOAK_CLIENT_ID=hotel-frontend

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID

# Tận dụng Docker Layer Cache cho node_modules
COPY package.json package-lock.json ./
RUN npm ci

# Copy toàn bộ mã nguồn Frontend
COPY . .

# Build ra thư mục tĩnh /app/dist
RUN npm run build

# ==============================================================================
# STAGE 2: PRODUCTION STATIC RUNNER (Nginx 1.27 Alpine siêu nhẹ < 30MB)
# ==============================================================================
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Xóa các tệp mẫu mặc định của Nginx
RUN rm -rf ./*

# Copy kết quả build từ Stage 1
COPY --from=builder /app/dist .

# Copy cấu hình SPA fallback
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

# Cổng nội bộ 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
