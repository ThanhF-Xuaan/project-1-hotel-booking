<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="db/changelogs/incremental/2026/20261018-120000-add-payroll-summary-unique-index.xml">

    <changeSet id="20261018-120000-add-payroll-summary-unique-index" author="member1">
        <preConditions onFail="HALT" onError="HALT">
            <tableExists tableName="payroll_summary"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM (
                    SELECT staff_id, period_month, period_year
                    FROM payroll_summary
                    WHERE is_deleted = FALSE
                    GROUP BY staff_id, period_month, period_year
                    HAVING COUNT(*) > 1
                ) duplicates;
            </sqlCheck>
        </preConditions>

        <comment>T05: Partial unique index on payroll_summary (staff_id, period_month, period_year) for active records</comment>

        <sqlFile path="db/sqlFile/incremental/2026/20261018-120000-add-payroll-summary-unique-index.sql"
                 relativeToChangelogFile="false"
                 splitStatements="false"
                 stripComments="false"/>

        <rollback>
            <sql>
                DROP INDEX uq_payroll_summary_staff_period_active;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
