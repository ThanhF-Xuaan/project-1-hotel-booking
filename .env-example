# ==============================================================================
#                   HỆ THỐNG QUẢN LÝ KHÁCH SẠN (HOTEL BOOKING)
#              TẬP TIN MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env-example)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị phù hợp
#   PowerShell: Copy-Item .env-example .env
#   Bash/Linux: cp .env-example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU (POSTGRESQL 16)
# ------------------------------------------------------------------------------
# Host truy cập DB:
# - Chạy Spring Boot local ngoài máy host: localhost
# - Chạy trong Docker network: postgres_db
DB_HOST=localhost
# Cổng kết nối DB bên ngoài máy Host (tránh đụng cổng 5432 mặc định)
DB_PORT=5433
DB_NAME=hotel_booking_db
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH LIQUIBASE DATABASE MIGRATION
# ------------------------------------------------------------------------------
# Bật/tắt Liquibase khi chạy Spring Boot độc lập (true: tự động chạy khi khởi động app)
SPRING_LIQUIBASE_ENABLED=true
# Contexts thực thi ChangeSets:
# - master-data: Dữ liệu nền tảng hệ thống bắt buộc (Permissions, Roles, Tax, Currencies...)
# - dev-seed: Dữ liệu mẫu khởi tạo phục vụ phát triển & test (Khách sạn mẫu, phòng, user...)
LIQUIBASE_CONTEXTS=master-data,dev-seed

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH BỘ NHỚ ĐỆM (REDIS CACHE 7)
# ------------------------------------------------------------------------------
# Host truy cập Redis: localhost (local) hoặc redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH ĐỊNH DANH & PHÂN QUYỀN (KEYCLOAK IAM 24)
# ------------------------------------------------------------------------------
# Cổng Keycloak được public ra máy host (truy cập UI quản trị: http://localhost:8081)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=hotel-realm
KEYCLOAK_CLIENT_ID=hotel-frontend

# Cấu hình Issuer URI & JWKS cho Spring Boot Resource Server xác thực JWT
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/hotel-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/hotel-realm/protocol/openid-connect/certs

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH CỔNG DỊCH VỤ ỨNG DỤNG (BACKEND & FRONTEND)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH DÀNH CHO FRONTEND (REACT 19 / VITE)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=hotel-realm
VITE_KEYCLOAK_CLIENT_ID=hotel-frontend