# ==============================================================================
#        HỆ THỐNG QUẢN LÝ KHÁCH SẠN SMARTSTAY - CẤU HÌNH MẪU PRODUCTION (.env.prod.example)
#
# LƯU Ý BẢO MẬT:
# 1. Tệp này CHỈ là mẫu cấu hình. KHÔNG ĐƯỢC CHỨA MẬT KHẨU THẬT trong tệp này.
# 2. Khi triển khai lên máy chủ OCI:
#    cp .env.prod.example .env.prod
#    chmod 600 .env.prod
# 3. Điền các giá trị thực tế lấy từ OCI Vault / Password Manager an toàn.
# 4. Tệp .env.prod đã được cấu hình trong .gitignore, tuyệt đối không commit lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TÊN MIỀN & CHỨNG CHỈ SSL LET'S ENCRYPT
# ------------------------------------------------------------------------------
DOMAIN_NAME=smartstay.space
LETSENCRYPT_EMAIL=admin@smartstay.space
NGINX_PORT=80
NGINX_SSL_PORT=443

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (Kết nối mạng nội bộ Docker qua port 5432)
# Mật khẩu phức tạp >= 16 ký tự (chữ hoa, chữ thường, số và ký tự đặc biệt)
# ------------------------------------------------------------------------------
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=hotel_booking_prod_db
DB_USER=hotel_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_MIN_16_CHARS

# ------------------------------------------------------------------------------
# 3. REDIS CACHE (Mạng nội bộ Docker qua port 6379)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. KEYCLOAK IAM (Quarkus Distribution v24.0.4)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=hotel_iam_admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_IAM_ADMIN_PASSWORD
KEYCLOAK_REALM=hotel-realm
KEYCLOAK_CLIENT_ID=hotel-backend
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_STRONG_CLIENT_SECRET
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# URL OIDC nội bộ và công khai:
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URI=https://smartstay.space/realms/hotel-realm
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/hotel-realm/protocol/openid-connect/certs

# ------------------------------------------------------------------------------
# 5. MINIO OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
# Tài khoản Quản trị Cụm MinIO (Chỉ dùng cho sysadmin, không phơi bày ra Internet)
MINIO_ROOT_USER=hotel_storage_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_STORAGE_ADMIN_PASSWORD

# Cấu hình kết nối Backend Runtime qua mạng Docker nội bộ (Luồng 1)
HOTEL_STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hotel_backend_app_user
S3_SECRET_KEY=REPLACE_WITH_STRONG_S3_SECRET_KEY
S3_BUCKET_NAME=hotel-booking-storage
S3_PATH_STYLE_ACCESS=true
S3_AUTO_CREATE_BUCKET=true
S3_CDN_PUBLIC_BASE_URL=https://smartstay.space/storage
S3_PUBLIC_ENDPOINT=https://smartstay.space/storage

# ------------------------------------------------------------------------------
# 6. BẢO MẬT AI ROOM ADVISOR (HMAC-SHA256 Token Secret, tối thiểu 64 ký tự)
# ------------------------------------------------------------------------------
HOTEL_AI_ADVISOR_SECURITY_ANON_TOKEN_SECRET=REPLACE_WITH_RANDOM_HMAC_SHA256_KEY_MIN_64_CHARS
HOTEL_AI_ADVISOR_SECURITY_ANON_TOKEN_SECONDARY_SECRET=

# ------------------------------------------------------------------------------
# 7. CỔNG THANH TOÁN TRỰC TUYẾN (Cấu hình VNPAY Sandbox cho đồ án demo)
# ------------------------------------------------------------------------------
VNPAY_TMN_ID=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://smartstay.space/api/v1/payments/vnpay-return
VNPAY_FE_RESULT_URL=https://smartstay.space/payment/result
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
