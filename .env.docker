# ==============================================================================
#        HỆ THỐNG QUẢN LÝ KHÁCH SẠN - CẤU HÌNH DOCKER NETWORK (.env.docker)
# ==============================================================================

# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Kết nối nội bộ container qua port 5432)
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=hotel_booking_db
DB_USER=postgres
DB_PASSWORD=123456

# 2. LIQUIBASE MIGRATION (Tắt trên backend vì đã có liquibase runner chuyên dụng)
SPRING_LIQUIBASE_ENABLED=false
LIQUIBASE_CONTEXTS=master-data,dev-seed

# 3. REDIS CACHE (Kết nối nội bộ container redis qua port 6379)
REDIS_HOST=redis
REDIS_PORT=6379
DEV_REDIS_PORT=6380

# 4. KEYCLOAK IAM (Kết nối nội bộ container keycloak qua port 8080)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=hotel-realm

# URL gọi nội bộ (REST Client, Admin CLI)
KEYCLOAK_SERVER_URL=http://keycloak:8080

# OAuth2 JWT Validation
# - ISSUER_URI: Khớp claim 'iss' từ browser gửi lên (http://localhost:8081)
# - JWK_SET_URI: Tải JWKS public key trực tiếp qua mạng Docker (http://keycloak:8080)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/hotel-realm
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/hotel-realm/protocol/openid-connect/certs

# Keycloak Clients
KEYCLOAK_CLIENT_ID=hotel-backend
KEYCLOAK_CLIENT_SECRET=hotel-backend-secret-key-123456
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# 5. CỔNG DỊCH VỤ ỨNG DỤNG
BACKEND_PORT=8080
FRONTEND_PORT=3000

# 6. FRONTEND REACT VITE (Chạy trên browser của máy Host)
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=hotel-realm
VITE_KEYCLOAK_CLIENT_ID=hotel-frontend

# 7. MINIO / S3 OBJECT STORAGE (Lưu trữ ảnh phòng, banner, hợp đồng, media)
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:268d68a2a3b6fc65f905a61f84d7eab6345ce6bff14f551e2b028ec31e6a1341
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=hotelbooking123
HOTEL_STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=hotelbooking123
S3_BUCKET_NAME=hotel-booking-storage
S3_PATH_STYLE_ACCESS=true

# 8. NGINX INGRESS GATEWAY & REVERSE PROXY
NGINX_PORT=80
NGINX_SSL_PORT=443

# Cấu hình URL truy cập tệp tĩnh công khai qua Nginx S3 Asset Gateway
S3_CDN_PUBLIC_BASE_URL=http://localhost/storage

